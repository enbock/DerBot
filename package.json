{
  "name": "derbot",
  "version": "1.0.0",
  "description": "DerBot - Clean Architecture TypeScript Application",
  "type": "module",
  "main": "build/backend/main.js",
  "scripts": {
    "build": "npm run build:backend && npm run build:frontend",
    "build:backend": "webpack --config webpack.backend.config.cjs",
    "build:frontend": "webpack --config webpack.frontend.config.cjs",
    "build:watch": "npm run build:backend -- --watch & npm run build:frontend -- --watch",
    "start": "npm run build && node build/backend/main.js",
    "test": "tsx --test backend/**/*.test.ts frontend/**/*.test.ts",
    "dev": "npm run build:watch & npm run start"
  },
  "keywords": [
    "bot",
    "typescript",
    "clean-architecture",
    "ddd"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/qrcode": "^1.5.5",
    "copy-webpack-plugin": "^11.0.0",
    "ts-loader": "^9.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "otplib": "^12.0.1",
    "qrcode": "^1.5.3"
  }
}
